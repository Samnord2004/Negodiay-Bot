# =========================================================================
# Конфигурация окружения для портала команды «Негодяи»
# =========================================================================

# Порт приложения (для Beget VPS / Docker по умолчанию 3000)
# На Beget Shared Hosting Passenger переменная PORT передаётся панелью автоматически
PORT=3000
NODE_ENV=production

# -------------------------------------------------------------------------
# База данных PostgreSQL (выберите один из удобных вариантов):
# -------------------------------------------------------------------------
# Вариант 1: Полная строка подключения DATABASE_URL (например, Beget Managed PostgreSQL):
# DATABASE_URL="postgres://user:password@host:5432/dbname"

# Вариант 2: Раздельные параметры подключения к PostgreSQL:
# SQL_HOST="localhost"
# SQL_USER="postgres"
# SQL_PASSWORD="your_strong_password"
# SQL_DB_NAME="negodyai_db"

# Примечание: если база данных PostgreSQL временно недоступна,
# приложение автоматически сохраняет и загружает данные из локального
# резервного файла data/app_storage.json, гарантируя бесперебойность работы!

# -------------------------------------------------------------------------
# Внешние сервисы и ИИ:
# -------------------------------------------------------------------------
# GEMINI_API_KEY: Ключ для работы ИИ-советника и автогенерации (опционально)
GEMINI_API_KEY=""

# APP_URL: Публичный URL вашего домена (например, https://negodyai.ru)
APP_URL="http://localhost:3000"
